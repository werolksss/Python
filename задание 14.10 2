# Файл main.py

import math
import random
import statistics
import time
import json
import re
from collections import Counter
from datetime import date, timedelta
import geometry

def read_date(prompt):
    day, month, year = map(int, input(prompt).split())
    return date(year, month, day)

def birthday_in_year(birth, year):
    # Для 29 февраля в невисокосном году берём 28 февраля.
    try:
        return birth.replace(year=year)
    except ValueError:
        return date(year, 2, 28)

def save_json(filename, data):
    with open(filename, "w", encoding="utf-8") as file:
        json.dump(data, file, ensure_ascii=False, indent=4)
    print("Сохранено:", filename)

# Задача 1. Математические вычисления
def task1():
    a, b, c = map(float, input("Введите a, b, c: ").split())
    values = [a, b, c]

    print("Среднее арифметическое:", sum(values) / 3)

    # В задании пример 4, 9, -16 → 6.
    # Чтобы получить этот результат, считаем геометрическое
    # среднее только положительных чисел.
    positive = [x for x in values if x > 0]

    if not positive:
        print("Среднее геометрическое: нет положительных чисел.")
    elif len(positive) == 1:
        print("Среднее геометрическое положительных:", positive[0])
    elif len(positive) == 2:
        print(
            "Среднее геометрическое положительных:",
            math.sqrt(positive[0] * positive[1])
        )
    else:
        print(
            "Среднее геометрическое положительных:",
            (a * b * c) ** (1 / 3)
        )

    print("Максимальное по модулю значение:",
          max(math.fabs(x) for x in values))

# Задача 2. Случайные числа
def task2():
    values = [random.randint(-30, 30) for _ in range(15)]

    print("Исходный массив:", values)
    print("Сумма положительных:", sum(x for x in values if x > 0))
    print("Количество отрицательных:", sum(x < 0 for x in values))
    print("Минимум:", min(values))
    print("Максимум:", max(values))

# Задача 3. Дата рождения
def task3():
    birth = read_date("Введите дату рождения: день месяц год: ")
    today = date.today()

    if birth > today:
        raise ValueError("Дата рождения находится в будущем.")

    weekdays = [
        "понедельник", "вторник", "среда", "четверг",
        "пятница", "суббота", "воскресенье"
    ]

    anniversary = birthday_in_year(birth, today.year)
    age = today.year - birth.year - (today < anniversary)

    if anniversary >= today:
        next_birthday = anniversary
    else:
        next_birthday = birthday_in_year(birth, today.year + 1)

    print("Сегодня:", today.strftime("%d.%m.%Y"))
    print("День недели рождения:", weekdays[birth.weekday()])
    print("Полных лет:", age)
    print("Дней до дня рождения:", (next_birthday - today).days)

# Задача 4. Статистика оценок
def task4():
    grades = list(map(int, input("Введите 10–20 оценок от 2 до 5: ").split()))

    if not 10 <= len(grades) <= 20:
        raise ValueError("Нужно от 10 до 20 оценок.")
    if any(x < 2 or x > 5 for x in grades):
        raise ValueError("Оценки должны быть от 2 до 5.")

    print("Среднее арифметическое:", statistics.mean(grades))
    print("Медиана:", statistics.median(grades))
    print("Мода:", statistics.mode(grades))
    print("Все моды:", statistics.multimode(grades))
    print("Выборочное стандартное отклонение:", statistics.stdev(grades))

# Задача 5. Сортировка и поиск
def task5():
    values = [random.randint(-30, 30) for _ in range(20)]

    print("Исходный массив:", values)
    print("По возрастанию:", sorted(values))

    descending = values.copy()
    descending.sort(reverse=True)
    print("По убыванию:", descending)

    number = int(input("Введите число для поиска: "))
    print("Найдено." if number in values else "Не найдено.")
    print("Количество чётных:", sum(x % 2 == 0 for x in values))

    large = [random.randint(-10000, 10000) for _ in range(1000)]
    first = large.copy()
    second = large.copy()

    start = time.perf_counter_ns()
    first.sort()
    elapsed1 = time.perf_counter_ns() - start

    start = time.perf_counter_ns()
    sorted(second)
    elapsed2 = time.perf_counter_ns() - start

    print("Сортировка 1000 элементов:")
    print("list.sort():", elapsed1, "нс")
    print("sorted():", elapsed2, "нс")

# Задача 6. Строки
def task6():
    text = input("Введите строку: ")
    substring = input("Введите подстроку для поиска: ")

    print("Длина строки:", len(text))
    print("Верхний регистр:", text.upper())

    position = text.find(substring)
    if position == -1:
        print("Подстрока не найдена.")
    else:
        print("Позиция подстроки, начиная с 1:", position + 1)

    print("Замена русской буквы 'а':", text.replace("а", "*"))
    print("Строка наоборот:", text[::-1])

# Задача 7. Коллекции
def task7():
    text = input("Введите текст: ")
    words = re.findall(r"[^\W\d_]+", text.lower())
    frequencies = Counter(words)

    print("Частота каждого слова:")
    for word in sorted(frequencies):
        print(word, ":", frequencies[word])

    print("Три самых частых слова:")
    for word, count in frequencies.most_common(3):
        print(word, ":", count)

    print("Уникальные слова по алфавиту:")
    print(", ".join(sorted(frequencies)))

# Задача 8. Файлы студентов
def task8():
    count = int(input("Введите количество студентов: "))
    if count <= 0:
        raise ValueError("Количество должно быть положительным.")

    students = []

    for i in range(count):
        print("Студент", i + 1)
        name = input("ФИО: ").strip()
        group = input("Группа: ").strip()
        average = float(input("Средний балл: ").replace(",", "."))

        if not name or not group:
            raise ValueError("ФИО и группа не должны быть пустыми.")
        if not 2 <= average <= 5:
            raise ValueError("Средний балл должен быть от 2 до 5.")

        students.append({
            "name": name,
            "group": group,
            "average": average
        })

    save_json("students.json", students)

    with open("students.json", "r", encoding="utf-8") as file:
        loaded = json.load(file)

    print("Прочитанные данные:")
    for student in loaded:
        print(student["name"], student["group"], student["average"])

    best = max(loaded, key=lambda student: student["average"])
    print("Студент с максимальным баллом:", best)

    filtered = [student for student in loaded if student["average"] > 4.5]

    print("Студенты с баллом выше 4.5:")
    for student in filtered:
        print(student["name"], student["group"], student["average"])

    save_json("students_filtered.json", filtered)

# Задача 9. Дневник погоды
def task9():
    start_date = date.today()

    days = [
        {
            "date": (start_date + timedelta(days=i)).isoformat(),
            "temperature": random.randint(-20, 35)
        }
        for i in range(7)
    ]

    temperatures = [day["temperature"] for day in days]
    minimum = min(temperatures)
    maximum = max(temperatures)

    coldest = [day["date"] for day in days if day["temperature"] == minimum]
    warmest = [day["date"] for day in days if day["temperature"] == maximum]

    report = {
        "days": days,
        "average": statistics.mean(temperatures),
        "minimum": minimum,
        "maximum": maximum,
        "coldest_days": coldest,
        "warmest_days": warmest
    }

    print("Гистограмма: один # = 1 градус.")
    print("Отрицательные температуры слева от |, положительные справа.")

    for day in days:
        temperature = day["temperature"]
        left = "#" * max(0, -temperature)
        right = "#" * max(0, temperature)
        print(f"{day['date']} {temperature:+3} {left:>20}|{right}")

    print("Средняя температура:", report["average"])
    print("Минимальная:", minimum)
    print("Максимальная:", maximum)
    print("Самые холодные дни:", ", ".join(coldest))
    print("Самые тёплые дни:", ", ".join(warmest))

    save_json("weather.json", report)

# Задача 10. Собственный модуль
def task10():
    radius = float(input("Введите радиус: "))
    print("Площадь круга:", geometry.circle_area(radius))
    print("Длина окружности:", geometry.circumference(radius))
    print("Объём шара:", geometry.sphere_volume(radius))

    a, b, c = map(float, input("Введите три стороны треугольника: ").split())
    print("Площадь треугольника:", geometry.triangle_area(a, b, c))

def main():
    tasks = [
        task1, task2, task3, task4, task5,
        task6, task7, task8, task9, task10
    ]

    while True:
        print("""
1. Математические вычисления
2. Случайные числа
3. Дата рождения
4. Статистика оценок
5. Сортировка и поиск
