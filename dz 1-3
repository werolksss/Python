def is_valid_move(board, position):
    return 0 <= position < 9 and board[position] == " "

def player_move(board, symbol):
    while True:
        value = input(f"Игрок {symbol}, выберите клетку (1–9): ")

        try:
            position = int(value) - 1
        except ValueError:
            print("Введите число от 1 до 9.")
            continue

        if not is_valid_move(board, position):
            print("Клетка занята или номер неверный.")
            continue

        board[position] = symbol
        return
