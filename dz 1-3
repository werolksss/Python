def prepare_modules():
    folder = Path(__file__).resolve().parent / "python_tasks"
    folder.mkdir(exist_ok=True)

    for name, source in FILES.items():
        path = folder / name

        # Существующие файлы сохраняются, чтобы не стереть правки.
        if not path.exists():
            path.write_text(source.lstrip(), encoding="utf-8")

    return folder


if __name__ == "__main__":
    try:
        folder = prepare_modules()
        sys.path.insert(0, str(folder))
        runpy.run_path(str(folder / "main.py"), run_name="__main__")
    except (OSError, EOFError, KeyboardInterrupt) as error:
        print("Программа завершена:", error)
