from contacts_data import Contact

def find_contact(contacts, name):
    for contact in contacts:
        if contact.name.casefold() == name.strip().casefold():
            return contact
    return None

def add_contact(contacts, name, phone, email):
    name = name.strip()
    phone = phone.strip()
    email = email.strip()

    if not all((name, phone, email)):
        raise ValueError("Все поля должны быть заполнены.")

    if find_contact(contacts, name):
        raise ValueError("Контакт с таким именем уже существует.")

    contacts.append(Contact(name, phone, email))

def delete_contact(contacts, name):
    contact = find_contact(contacts, name)

    if contact is None:
        return False

    contacts.remove(contact)
    return True
''',

    "contacts_files.py": '''
import json
from pathlib import Path
from dataclasses import asdict
from contacts_operations import add_contact

DEFAULT_FILE = Path(__file__).with_name("contacts.json")

def save_contacts(contacts, filename=DEFAULT_FILE):
    path = Path(filename)
    temporary = path.with_suffix(path.suffix + ".tmp")

    data = [asdict(contact) for contact in contacts]

    temporary.write_text(
        json.dumps(data, ensure_ascii=False, indent=4),
        encoding="utf-8"
    )
    temporary.replace(path)

def load_contacts(filename=DEFAULT_FILE):
    data = json.loads(Path(filename).read_text(encoding="utf-8"))

    if not isinstance(data, list):
        raise ValueError("В файле должен быть список контактов.")

    contacts = []

    for item in data:
        if not isinstance(item, dict):
            raise ValueError("Неверная структура контакта.")

        if set(item) != {"name", "phone", "email"}:
            raise ValueError("Неверные поля контакта.")

        if not all(isinstance(value, str) for value in item.values()):
            raise ValueError("Поля контакта должны быть строками.")

        add_contact(
            contacts,
            item["name"],
            item["phone"],
            item["email"]
        )

    return contacts
''',

